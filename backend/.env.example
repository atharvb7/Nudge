# Copy to .env (or export) — all optional.

# Local LLM (default). Install Ollama and run: ollama pull llama3.1:8b
NUDGE_USE_OLLAMA=1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
NUDGE_LLM_TIMEOUT=20

# Cloud fallback — OFF unless both are set. Shown as "cloud" in the privacy center.
NUDGE_ALLOW_CLOUD=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Retrieval: auto (MiniLM + Chroma if installed) or keyword (built-in TF-IDF)
NUDGE_EMBEDDINGS=auto
# NUDGE_CHROMA_DIR=.chroma
# NUDGE_STRATEGIES_PATH=../shared/src/strategies.json

# Local speech-to-text (optional). whisper.cpp needs ffmpeg for browser audio.
WHISPER_CPP_BIN=
WHISPER_MODEL=
# or: pip install faster-whisper   (FASTER_WHISPER_MODEL=base.en)

# Crisis resources default region when the extension doesn't send one: IN, US, CA, UK, AU, OTHER
NUDGE_REGION=IN
