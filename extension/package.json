{
  "name": "@nudge/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts --mode content && vite build --config vite.content.config.ts --mode bridge",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.1.0",
    "@fontsource/lexend": "^5.1.0",
    "@nudge/shared": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
